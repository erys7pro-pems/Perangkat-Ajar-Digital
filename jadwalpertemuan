<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Jadwal Pertemuan</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Rajdhani:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{color-scheme:dark;--bg:#040a12;--panel:rgba(9,24,40,.82);--ink:#d6f3ff;--muted:#7fa6bb;--line:#17486a;--cyan:#3de0ff;--glow:rgba(61,224,255,.35);--danger:#ff6b4a;--head:#0a2237;--field:#061523;
--disp:"Orbitron","Eurostile","Segoe UI",sans-serif;--body:"Rajdhani","Segoe UI",system-ui,sans-serif}
*{box-sizing:border-box}
body{margin:0;color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.45;min-height:100vh;
background:radial-gradient(1000px 520px at 85% -10%,rgba(61,224,255,.14),transparent 60%),radial-gradient(700px 420px at 0% 100%,rgba(30,110,200,.16),transparent 60%),
linear-gradient(rgba(61,224,255,.045) 1px,transparent 1px) 0 0/40px 40px,linear-gradient(90deg,rgba(61,224,255,.045) 1px,transparent 1px) 0 0/40px 40px,var(--bg)}
main{max-width:920px;margin:0 auto;padding:24px 16px 56px}
.hud{display:flex;align-items:center;gap:16px;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--line)}
.reactor{width:64px;height:64px;flex:none;filter:drop-shadow(0 0 8px var(--glow))}
.reactor .spin{transform-origin:50% 50%;animation:spin 18s linear infinite}
.reactor .spin2{transform-origin:50% 50%;animation:spin 9s linear infinite reverse}
@keyframes spin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.reactor .spin,.reactor .spin2{animation:none}}
h1{font-family:var(--disp);font-size:1.55rem;letter-spacing:.14em;margin:0;color:var(--cyan);text-shadow:0 0 14px var(--glow);font-weight:700}
h2{font-family:var(--disp);font-size:.92rem;letter-spacing:.08em;margin:0 0 12px;color:var(--cyan);font-weight:500}
p.sub{margin:2px 0 0;color:var(--muted)}
.hud .stat{margin-left:auto;text-align:right;font-family:var(--disp);font-size:.72rem;letter-spacing:.1em;color:var(--muted)}
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#3dffa0;box-shadow:0 0 8px #3dffa0;margin-right:6px}
nav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
nav button{font-family:var(--disp);font-size:.78rem;letter-spacing:.06em}
nav button.on{background:rgba(61,224,255,.16);color:var(--cyan);border-color:var(--cyan);box-shadow:0 0 14px var(--glow),inset 0 0 12px rgba(61,224,255,.12)}
section{display:none}section.on{display:block}
.card{position:relative;background:var(--panel);border:1px solid var(--line);border-radius:4px;padding:18px;margin-bottom:16px;backdrop-filter:blur(4px)}
.card::before,.card::after{content:"";position:absolute;width:14px;height:14px;border:2px solid var(--cyan);pointer-events:none}
.card::before{top:-1px;left:-1px;border-right:0;border-bottom:0}
.card::after{bottom:-1px;right:-1px;border-left:0;border-top:0}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;align-items:end}
label{display:flex;flex-direction:column;gap:4px;font-size:.88rem;color:var(--muted);letter-spacing:.03em}
input,select{font:inherit;color:var(--ink);background:var(--field);border:1px solid var(--line);border-radius:3px;padding:8px 10px;min-width:0;width:100%}
input::placeholder{color:#47677b}
input:focus,select:focus{outline:none;border-color:var(--cyan);box-shadow:0 0 0 1px var(--cyan),0 0 12px var(--glow)}
button:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
button{font:inherit;font-weight:600;cursor:pointer;padding:8px 16px;border:1px solid var(--line);background:rgba(61,224,255,.04);color:var(--ink);
clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px);transition:background .15s,box-shadow .15s,border-color .15s}
button:hover:not(:disabled){border-color:var(--cyan);background:rgba(61,224,255,.12)}
button.primary{background:rgba(61,224,255,.2);color:var(--cyan);border-color:var(--cyan);box-shadow:0 0 12px var(--glow)}
button.primary:hover:not(:disabled){background:rgba(61,224,255,.32)}
button.del{padding:3px 10px;font-size:.85rem;color:var(--danger);border-color:rgba(255,107,74,.4);clip-path:none;border-radius:3px;background:transparent}
button.del:hover{background:rgba(255,107,74,.12);border-color:var(--danger)}
button:disabled{opacity:.4;cursor:not-allowed}
.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
.wrap{overflow-x:auto;border:1px solid var(--line);border-radius:4px;background:rgba(4,12,22,.6)}
table{border-collapse:collapse;width:100%;min-width:480px}
th,td{padding:8px 12px;text-align:left;border-bottom:1px solid rgba(23,72,106,.6);white-space:nowrap}
th{background:var(--head);font-family:var(--disp);font-weight:500;font-size:.72rem;letter-spacing:.08em;color:var(--cyan)}
tbody tr:hover{background:rgba(61,224,255,.06)}
tr:last-child td{border-bottom:0}
.empty{padding:20px;text-align:center;color:var(--muted)}
.msg{min-height:1.5em;margin:0 0 12px;color:var(--cyan);text-shadow:0 0 8px var(--glow)}
.msg.err{color:var(--danger);text-shadow:none}
.msg:not(:empty)::before{content:"> ";opacity:.7}
.hasil{margin-top:14px;padding:12px 14px;border-left:3px solid var(--cyan);background:rgba(61,224,255,.07);display:none}
</style>
</head>
<body>
<main>
<header class="hud">
  <svg class="reactor" viewBox="0 0 100 100" aria-hidden="true">
    <circle cx="50" cy="50" r="46" fill="none" stroke="#17486a" stroke-width="2"/>
    <g class="spin"><circle cx="50" cy="50" r="40" fill="none" stroke="#3de0ff" stroke-width="3" stroke-dasharray="14 8 40 8"/></g>
    <g class="spin2"><circle cx="50" cy="50" r="30" fill="none" stroke="#3de0ff" stroke-width="2" stroke-dasharray="6 6" opacity=".8"/></g>
    <circle cx="50" cy="50" r="20" fill="rgba(61,224,255,.12)" stroke="#3de0ff" stroke-width="2"/>
    <circle cx="50" cy="50" r="9" fill="#d6f3ff"/>
  </svg>
  <div>
    <h1>J.A.R.V.I.S.</h1>
    <p class="sub">Modul jadwal pertemuan. Atur pola mingguan per versi, lalu buat pertemuan otomatis.</p>
  </div>
  <div class="stat"><span class="dot"></span>SISTEM AKTIF<br><span id="clk"></span></div>
</header>
<nav id="nav">
  <button data-t="gen" class="on">Buat otomatis</button>
  <button data-t="ver">Versi & pola</button>
  <button data-t="lib">Libur</button>
  <button data-t="jad">Daftar jadwal</button>
</nav>
<p class="msg" id="msg" role="status"></p>

<section id="s-gen" class="on">
  <div class="card">
    <h2>Buat pertemuan dari pola</h2>
    <div class="grid">
      <label>Versi<select id="gv"></select></label>
      <label>Dari tanggal<input id="gd" type="date"></label>
      <label>Sampai tanggal<input id="gs" type="date"></label>
      <button id="prev" type="button" class="primary">Pratinjau</button>
    </div>
    <div class="hasil" id="hasil"></div>
    <div class="row"><button id="apply" type="button" class="primary" disabled>Terapkan</button></div>
  </div>
  <p class="sub">Terapkan menambah pertemuan sesuai pola, melewati hari libur, dan mengganti pertemuan otomatis lama yang belum punya jurnal. Pertemuan manual dan yang sudah punya jurnal tidak disentuh.</p>
</section>

<section id="s-ver">
  <div class="card">
    <h2>Versi jadwal</h2>
    <div class="grid">
      <label>Pilih versi<select id="vsel"></select></label>
      <label>Nomor versi<input id="vn" type="text" inputmode="numeric"></label>
      <label>Berlaku mulai<input id="vm" type="date"></label>
      <label>Berlaku sampai (opsional)<input id="vs" type="date"></label>
      <label>Catatan<input id="vc" type="text" placeholder="mis. revisi waka kurikulum"></label>
    </div>
  </div>
  <div class="card">
    <h2>Pola mingguan</h2>
    <div class="wrap"><table><thead><tr><th>Hari</th><th>Jam ke</th><th>Kelas</th><th></th></tr></thead><tbody id="pola"></tbody></table></div>
    <div class="row"><button id="addp" type="button">Tambah baris</button><button id="savev" type="button" class="primary">Simpan versi</button></div>
  </div>
  <p class="sub">Versi baru otomatis menyalin pola versi terakhir, jadi kamu cukup mengubah bagian yang direvisi. Saat tanggal mulai diisi, versi sebelumnya otomatis berakhir sehari sebelumnya.</p>
</section>

<section id="s-lib">
  <div class="card">
    <h2>Hari libur dan kegiatan sekolah</h2>
    <div class="wrap"><table><thead><tr><th>Mulai</th><th>Selesai</th><th>Keterangan</th><th></th></tr></thead><tbody id="lib"></tbody></table></div>
    <div class="row"><button id="addl" type="button">Tambah baris</button><button id="savel" type="button" class="primary">Simpan libur</button></div>
  </div>
</section>

<section id="s-jad">
  <form class="card" id="f" autocomplete="off">
    <h2>Tambah satu pertemuan manual</h2>
    <div class="grid">
      <label>Versi<input id="mv" type="text" inputmode="numeric" required></label>
      <label>Tanggal<input id="mt" type="date" required></label>
      <label>Jam ke<input id="mj" type="text" placeholder="mis. 1-2" required></label>
      <label>Kelas<input id="mk" type="text" placeholder="mis. X IPA 1" required></label>
      <button class="primary" id="msub" type="submit">Simpan</button>
    </div>
  </form>
  <div class="row" style="justify-content:space-between;align-items:center">
    <h2 style="margin:0">Jadwal (<span id="count">0</span>)</h2>
    <input id="flt" type="search" placeholder="Cari kelas, versi, tanggal" style="max-width:240px">
  </div>
  <div class="wrap" style="margin-top:8px">
    <table><thead><tr><th>ID</th><th>Versi</th><th>Tanggal</th><th>Jam Ke</th><th>Kelas</th><th>Sumber</th><th></th></tr></thead><tbody id="rows"></tbody></table>
    <div class="empty" id="empty">Memuat data…</div>
  </div>
</section>
</main>
<script>
(function(){
var API="https://script.google.com/macros/s/AKfycbxQRNsIZtMSnqqLBNBa3V0_CaEUaC1SQjNr8kgOlW7e-k7Ss8-5RDRBOZj27dwVvBn2/exec";
var HARI=["Senin","Selasa","Rabu","Kamis","Jumat","Sabtu","Minggu"];
var cfg={versi:[],pola:[],libur:[]},data=[],polaE=[],liburE=[];
var $=function(i){return document.getElementById(i)};
function say(t,e){var m=$("msg");m.textContent=t;m.className="msg"+(e?" err":"")}
function esc(t){return String(t==null?"":t).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
function fmt(d){var p=String(d).split("-");return p.length===3?p[2]+"/"+p[1]+"/"+p[0]:d}
function get(q){return fetch(API+"?"+q).then(function(r){return r.json()})}
function post(o){o.modul="jadwal";return fetch(API,{method:"POST",mode:"no-cors",headers:{"Content-Type":"text/plain;charset=utf-8"},body:JSON.stringify(o)})}
function opts(list,sel,extra){return (extra||"")+list.map(function(v){return "<option value='"+esc(v)+"'"+(v===sel?" selected":"")+">Versi "+esc(v)+"</option>"}).join("")}

/* tab */
$("nav").addEventListener("click",function(e){var t=e.target.getAttribute("data-t");if(!t)return;
  [].forEach.call(document.querySelectorAll("nav button"),function(b){b.classList.toggle("on",b===e.target)});
  [].forEach.call(document.querySelectorAll("section"),function(s){s.classList.toggle("on",s.id==="s-"+t)})});

/* muat data */
function loadAll(){
  return Promise.all([get("action=jadwal-config"),get("action=jadwal-list")]).then(function(a){
    cfg=a[0];data=a[1].data||[];fillVersi();renderTable();
  }).catch(function(){$("empty").textContent="Data belum bisa dimuat.";say("Gagal memuat data. Periksa deployment Apps Script (akses Anyone) dan kode terbaru.",true)});
}
function daftarVersi(){return cfg.versi.map(function(v){return v.versi})}
function fillVersi(){
  var d=daftarVersi(),last=d[d.length-1]||"";
  $("gv").innerHTML=opts(d,last);
  var cur=$("vsel").value;
  $("vsel").innerHTML=opts(d,cur,"<option value=''>(versi baru)</option>");
  if(!$("mv").value)$("mv").value=last||"1";
  if(!polaE.length&&!$("vn").value)pilihVersi(last);
  renderLibur();
}
function pilihVersi(v){
  var d=daftarVersi();$("vsel").value=v;
  if(v){var x=cfg.versi.filter(function(i){return i.versi===v})[0];
    $("vn").value=x.versi;$("vm").value=x.mulai;$("vs").value=x.sampai;$("vc").value=x.catatan;
    polaE=cfg.pola.filter(function(p){return p.versi===v}).map(function(p){return{hari:p.hari,jam:p.jam,kelas:p.kelas}});
  }else{
    var nums=d.map(Number).filter(function(n){return!isNaN(n)}),nx=(nums.length?Math.max.apply(null,nums):0)+1,last=d[d.length-1];
    $("vn").value=nx;$("vm").value="";$("vs").value="";$("vc").value="";
    polaE=last?cfg.pola.filter(function(p){return p.versi===last}).map(function(p){return{hari:p.hari,jam:p.jam,kelas:p.kelas}}):[];
  }
  renderPola();
}
$("vsel").addEventListener("change",function(){pilihVersi(this.value)});

/* pola */
function renderPola(){
  $("pola").innerHTML=polaE.length?polaE.map(function(p,i){
    return "<tr><td><select data-i='"+i+"' data-k='hari'>"+HARI.map(function(h){return "<option"+(h===p.hari?" selected":"")+">"+h+"</option>"}).join("")+"</select></td>"+
    "<td><input data-i='"+i+"' data-k='jam' value='"+esc(p.jam)+"' placeholder='1-2'></td>"+
    "<td><input data-i='"+i+"' data-k='kelas' value='"+esc(p.kelas)+"' placeholder='X IPA 1'></td>"+
    "<td><button class='del' type='button' data-del='"+i+"'>Hapus</button></td></tr>";
  }).join(""):"<tr><td colspan='4' class='empty'>Belum ada pola. Tambah baris untuk mulai.</td></tr>";
}
$("pola").addEventListener("input",function(e){var t=e.target,i=t.getAttribute("data-i");if(i!==null)polaE[i][t.getAttribute("data-k")]=t.value});
$("pola").addEventListener("click",function(e){var i=e.target.getAttribute("data-del");if(i===null)return;polaE.splice(i,1);renderPola()});
$("addp").addEventListener("click",function(){var l=polaE[polaE.length-1];polaE.push({hari:l?l.hari:"Senin",jam:"",kelas:l?l.kelas:""});renderPola()});
$("savev").addEventListener("click",function(){
  var v=$("vn").value.trim();
  if(!v||!$("vm").value){say("Isi nomor versi dan tanggal berlaku mulai.",true);return}
  var pola=polaE.filter(function(p){return p.jam.trim()&&p.kelas.trim()});
  if(!pola.length){say("Isi minimal satu baris pola (jam ke dan kelas).",true);return}
  say("Menyimpan versi…");
  post({action:"versi-simpan",versi:v,mulai:$("vm").value,sampai:$("vs").value,catatan:$("vc").value,pola:pola})
   .then(loadAll).then(function(){
     var ok=daftarVersi().indexOf(v)>-1;say(ok?"Versi "+v+" tersimpan.":"Versi belum tersimpan. Periksa kode Apps Script.",!ok);
     if(ok){polaE=[];pilihVersi(v)}
   });
});

/* libur */
function renderLibur(){
  $("lib").innerHTML=liburE.length?liburE.map(function(l,i){
    return "<tr><td><input type='date' data-i='"+i+"' data-k='mulai' value='"+esc(l.mulai)+"'></td>"+
    "<td><input type='date' data-i='"+i+"' data-k='selesai' value='"+esc(l.selesai)+"'></td>"+
    "<td><input data-i='"+i+"' data-k='ket' value='"+esc(l.ket)+"' placeholder='mis. Libur semester'></td>"+
    "<td><button class='del' type='button' data-del='"+i+"'>Hapus</button></td></tr>";
  }).join(""):"<tr><td colspan='4' class='empty'>Belum ada hari libur.</td></tr>";
}
var liburInit=false;
function syncLibur(){if(!liburInit){liburE=cfg.libur.map(function(l){return{mulai:l.mulai,selesai:l.selesai,ket:l.ket}});liburInit=true}}
$("lib").addEventListener("input",function(e){var t=e.target,i=t.getAttribute("data-i");if(i!==null)liburE[i][t.getAttribute("data-k")]=t.value});
$("lib").addEventListener("click",function(e){var i=e.target.getAttribute("data-del");if(i===null)return;liburE.splice(i,1);renderLibur()});
$("addl").addEventListener("click",function(){liburE.push({mulai:"",selesai:"",ket:""});renderLibur()});
$("savel").addEventListener("click",function(){
  say("Menyimpan libur…");
  post({action:"libur-simpan",libur:liburE.filter(function(l){return l.mulai})}).then(function(){liburInit=false;return loadAll()}).then(function(){syncLibur();renderLibur();say("Libur tersimpan.")});
});

/* generate */
var rencanaOk=false;
function resetPrev(){rencanaOk=false;$("apply").disabled=true;$("hasil").style.display="none"}
["gv","gd","gs"].forEach(function(i){$(i).addEventListener("change",resetPrev)});
$("prev").addEventListener("click",function(){
  if(!$("gv").value||!$("gd").value||!$("gs").value){say("Pilih versi dan isi rentang tanggal.",true);return}
  say("Menghitung pratinjau…");
  get("action=jadwal-pratinjau&versi="+encodeURIComponent($("gv").value)+"&dari="+$("gd").value+"&sampai="+$("gs").value).then(function(r){
    if(r.galat){say(r.galat,true);return}
    var h="<strong>"+r.jumlahTambah+" pertemuan akan dibuat</strong> ("+fmt(r.dari)+" sampai "+fmt(r.sampai)+").<br>"+
      r.jumlahHapus+" pertemuan otomatis lama akan diganti. "+r.libur+" dilewati karena libur. "+r.duplikat+" sudah ada.";
    if(r.contoh.length)h+="<br><span style='color:var(--muted)'>Contoh: "+r.contoh.map(function(c){return fmt(c.tanggal)+" jam "+esc(c.jam)+" "+esc(c.kelas)}).join("; ")+"</span>";
    $("hasil").innerHTML=h;$("hasil").style.display="block";
    rencanaOk=r.jumlahTambah>0||r.jumlahHapus>0;$("apply").disabled=!rencanaOk;say("");
  }).catch(function(){say("Pratinjau gagal. Pastikan kode Apps Script sudah diperbarui dan di-deploy.",true)});
});
$("apply").addEventListener("click",function(){
  if(!rencanaOk||!confirm("Terapkan perubahan jadwal ini?"))return;
  $("apply").disabled=true;say("Membuat jadwal…");
  post({action:"generate",versi:$("gv").value,dari:$("gd").value,sampai:$("gs").value}).then(loadAll).then(function(){say("Jadwal dibuat. Lihat hasilnya di tab Daftar jadwal.");resetPrev()});
});

/* daftar & manual */
function renderTable(){
  var q=$("flt").value.trim().toLowerCase();
  var list=data.slice().sort(function(a,b){return (a.tanggal+a.jam).localeCompare(b.tanggal+b.jam)}).filter(function(r){
    return !q||[r.id,r.versi,fmt(r.tanggal),r.tanggal,r.jam,r.kelas,r.sumber].join(" ").toLowerCase().indexOf(q)>-1});
  $("count").textContent=list.length;
  $("empty").textContent="Tidak ada jadwal.";$("empty").style.display=list.length?"none":"block";
  $("rows").innerHTML=list.map(function(r){
    return "<tr><td>"+esc(r.id)+"</td><td>"+esc(r.versi)+"</td><td>"+fmt(r.tanggal)+"</td><td>"+esc(r.jam)+"</td><td>"+esc(r.kelas)+"</td><td>"+esc(r.sumber)+"</td><td><button class='del' type='button' data-id='"+esc(r.id)+"'>Hapus</button></td></tr>";
  }).join("");
}
$("flt").addEventListener("input",renderTable);
$("f").addEventListener("submit",function(e){
  e.preventDefault();$("msub").disabled=true;say("Menyimpan…");
  post({action:"add",versi:$("mv").value.trim(),tanggal:$("mt").value,jam:$("mj").value.trim(),kelas:$("mk").value.trim()})
   .then(loadAll).then(function(){$("mj").value="";$("mk").value="";say("Jadwal tersimpan.")})
   .catch(function(){say("Gagal menyimpan.",true)}).then(function(){$("msub").disabled=false});
});
$("rows").addEventListener("click",function(e){
  var id=e.target.getAttribute("data-id");if(!id||!confirm("Hapus jadwal ID "+id+"?"))return;
  say("Menghapus…");
  post({action:"delete",id:id}).then(loadAll).then(function(){
    var ada=data.some(function(r){return String(r.id)===id});
    say(ada?"Jadwal tidak dihapus. Kemungkinan sudah memiliki jurnal.":"Jadwal dihapus.",ada)});
});

var d=new Date();$("mt").value=d.getFullYear()+"-"+("0"+(d.getMonth()+1)).slice(-2)+"-"+("0"+d.getDate()).slice(-2);
loadAll().then(function(){syncLibur();renderLibur()});
})();
</script>
<script>
(function(){var c=document.getElementById("clk");function t(){var d=new Date();c.textContent=d.toLocaleDateString("id-ID",{day:"2-digit",month:"short",year:"numeric"})+" "+d.toLocaleTimeString("id-ID",{hour12:false})}t();setInterval(t,1000)})();
</script>
</body>
</html>
