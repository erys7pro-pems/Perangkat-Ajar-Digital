<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Input Jadwal Pertemuan</title>
<style>
:root{--bg:#f3f6f4;--surface:#fff;--ink:#16302b;--muted:#5d726c;--line:#d3ddd9;--accent:#1f6f5c;--accent-ink:#fff;--danger:#b3372f;--head:#e3ede9}
@media (prefers-color-scheme:dark){:root{--bg:#101a18;--surface:#17241f;--ink:#e6f0ec;--muted:#92aaa2;--line:#2b3d37;--accent:#4fb99b;--accent-ink:#0b1713;--danger:#ef8a80;--head:#1f322c}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Segoe UI",system-ui,-apple-system,Roboto,sans-serif;line-height:1.5}
main{max-width:860px;margin:0 auto;padding:24px 16px 48px}
h1{font-size:1.5rem;margin:0 0 4px}
p.sub{margin:0 0 20px;color:var(--muted)}
form{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:16px;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;align-items:end}
label{display:flex;flex-direction:column;gap:4px;font-size:.85rem;color:var(--muted)}
input{font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:9px 10px;min-width:0}
input:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
input[readonly]{opacity:.7}
button{font:inherit;cursor:pointer;border-radius:6px;padding:9px 14px;border:1px solid var(--line);background:var(--surface);color:var(--ink)}
button.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);font-weight:600}
button:disabled{opacity:.6;cursor:wait}
.bar{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:24px 0 8px}
.bar h2{font-size:1.05rem;margin:0}
.wrap{overflow-x:auto;background:var(--surface);border:1px solid var(--line);border-radius:10px}
table{border-collapse:collapse;width:100%;min-width:520px}
th,td{padding:10px 12px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}
th{background:var(--head);font-weight:600;font-size:.9rem}
tr:last-child td{border-bottom:0}
td.act{text-align:right}
td.act button{padding:4px 10px;font-size:.85rem;color:var(--danger)}
.empty{padding:24px;text-align:center;color:var(--muted)}
.msg{min-height:1.3em;margin:8px 0 0;font-size:.9rem;color:var(--accent)}
.msg.err{color:var(--danger)}
</style>
</head>
<body>
<main>
<h1>Input jadwal pertemuan</h1>
<p class="sub">Data tersimpan di Google Sheets melalui Apps Script.</p>

<form id="f" autocomplete="off">
  <label>ID<input id="id" readonly placeholder="otomatis"></label>
  <label>Versi<input id="versi" type="number" min="1" value="1" required></label>
  <label>Tanggal<input id="tanggal" type="date" required></label>
  <label>Jam ke<input id="jam" type="text" inputmode="numeric" placeholder="mis. 1-2" required></label>
  <label>Kelas<input id="kelas" type="text" placeholder="mis. X IPA 1" required></label>
  <button class="primary" id="submit" type="submit">Simpan</button>
</form>
<p class="msg" id="msg" role="status"></p>

<div class="bar">
  <h2>Tabel jadwal (<span id="count">0</span>)</h2>
  <button id="reload" type="button">Muat ulang</button>
</div>
<div class="wrap">
  <table>
    <thead><tr><th>ID</th><th>Versi</th><th>Tanggal</th><th>Jam Ke</th><th>Kelas</th><th></th></tr></thead>
    <tbody id="rows"></tbody>
  </table>
  <div class="empty" id="empty">Memuat data…</div>
</div>
</main>
<script>
(function(){
  var API="https://script.google.com/macros/s/AKfycbxQRNsIZtMSnqqLBNBa3V0_CaEUaC1SQjNr8kgOlW7e-k7Ss8-5RDRBOZj27dwVvBn2/exec";
  var data=[];
  var $=function(i){return document.getElementById(i)};
  function say(t,err){var m=$("msg");m.textContent=t;m.className="msg"+(err?" err":"")}
  function fmt(d){var p=String(d).split("-");return p.length===3?p[2]+"/"+p[1]+"/"+p[0]:d}
  function esc(t){return String(t).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
  function render(){
    $("count").textContent=data.length;
    $("empty").textContent="Belum ada jadwal. Isi formulir di atas untuk menambahkan.";
    $("empty").style.display=data.length?"none":"block";
    $("rows").innerHTML=data.map(function(r){
      return "<tr><td>"+esc(r.id)+"</td><td>"+esc(r.versi)+"</td><td>"+fmt(r.tanggal)+"</td><td>"+esc(r.jam)+"</td><td>"+esc(r.kelas)+"</td><td class='act'><button data-id='"+esc(r.id)+"' type='button'>Hapus</button></td></tr>";
    }).join("");
  }
  function load(){
    $("empty").style.display="block";$("empty").textContent="Memuat data…";
    return fetch(API+"?action=jadwal-list").then(function(r){return r.json()}).then(function(j){data=j.data||[];render()})
      .catch(function(){$("empty").textContent="Data belum bisa dimuat.";say("Gagal memuat data. Periksa akses deployment Apps Script (Anyone).",true)});
  }
  function post(obj){
    return fetch(API,{method:"POST",mode:"no-cors",headers:{"Content-Type":"text/plain;charset=utf-8"},body:JSON.stringify(obj)});
  }
  $("f").addEventListener("submit",function(e){
    e.preventDefault();
    var r={modul:"jadwal",action:"add",versi:$("versi").value.trim(),tanggal:$("tanggal").value,jam:$("jam").value.trim(),kelas:$("kelas").value.trim()};
    $("submit").disabled=true;say("Menyimpan…");
    post(r).then(function(){return load()}).then(function(){
      $("jam").value="";$("kelas").value="";$("jam").focus();say("Jadwal tersimpan.");
    }).catch(function(){say("Gagal menyimpan. Coba lagi.",true)}).then(function(){$("submit").disabled=false});
  });
  $("rows").addEventListener("click",function(e){
    var id=e.target.getAttribute&&e.target.getAttribute("data-id");
    if(!id||!confirm("Hapus jadwal ID "+id+"?"))return;
    say("Menghapus…");
    post({modul:"jadwal",action:"delete",id:id}).then(load).then(function(){var ada=data.some(function(r){return String(r.id)===id});if(ada)say("Jadwal tidak dihapus. Kemungkinan sudah memiliki jurnal.",true);else say("Jadwal dihapus.")}).catch(function(){say("Gagal menghapus.",true)});
  });
  $("reload").addEventListener("click",load);
  var d=new Date();$("tanggal").value=d.getFullYear()+"-"+("0"+(d.getMonth()+1)).slice(-2)+"-"+("0"+d.getDate()).slice(-2);
  load();
})();
</script>
</body>
</html>
